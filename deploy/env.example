# 環境変数設定例
# このファイルをコピーして .env ファイルを作成し、実際の値を設定してください

# ===================
# Supabase 設定
# ===================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=profile-images

# ===================
# Next.js フロントエンド用
# ===================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_API_BASE=https://your-api-gateway-url

# ===================
# API設定
# ===================
JWT_SECRET_KEY=your-very-long-and-secure-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===================
# AWS設定 (Terraform用)
# ===================
AWS_REGION=ap-northeast-1
AWS_PROFILE=default

# ===================
# デプロイ設定
# ===================
PROJECT_NAME=ocha
ENVIRONMENT=prod

# ===================
# 開発環境専用
# ===================
API_PORT=8000
FRONTEND_PORT=3000
DEBUG=true